@model ProductViewModel

<div class="container-fluid py-4">
    <a asp-action="Index" class="text-decoration-none text-secondary small fw-medium d-inline-flex align-items-center gap-1 mb-3">
        <i class="bi bi-arrow-left"></i> Back to products
    </a>
    <div class="card border shadow-sm overflow-hidden">
        <div class="card-header text-white py-3 px-4" style="background: linear-gradient(to right, #065f46, #282828, #191414);">
            <h5 class="mb-0 fw-bold"><i class="bi bi-plus-lg me-2"></i>@Model.Action</h5>
            <p class="mb-0 small" style="color: #1DB954;">Add a new product to your products</p>
        </div>
        <div class="card-body p-4">
            <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
            <form method="post" enctype="multipart/form-data">
                <input asp-for="@Model.Product.Id" type="hidden" />
                <input asp-for="@Model.Product.ImageUrl" type="hidden" />
                <div class="row">
                    <div class="col-lg-8">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="@Model.Product.Title" class="form-label fw-semibold small"></label>
                                <input asp-for="@Model.Product.Title" type="text" class="form-control" placeholder="Enter product name" />
                                <span asp-validation-for="@Model.Product.Title" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="@Model.Product.Description" class="form-label fw-semibold small"></label>
                                <input asp-for="@Model.Product.Description" type="text" class="form-control" placeholder="Enter product description" />
                                <span asp-validation-for="@Model.Product.Description" class="text-danger small"></span>
                            </div>
                            <div class="col-6">
                                <label asp-for="@Model.Product.Isbn" class="form-label fw-semibold small"></label>
                                <input asp-for="@Model.Product.Isbn" type="text" class="form-control" placeholder="Enter ISBN" />
                                <span asp-validation-for="@Model.Product.Isbn" class="text-danger small"></span>
                            </div>
                            <div class="col-6">
                                <label asp-for="@Model.Product.Author" class="form-label fw-semibold small"></label>
                                <input asp-for="@Model.Product.Author" type="text" class="form-control" placeholder="Enter author name" />
                                <span asp-validation-for="@Model.Product.Author" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="border rounded p-3 mt-3 bg-light">
                            <p class="text-uppercase fw-semibold text-secondary mb-3" style="font-size: 0.65rem; letter-spacing: 0.1em;">Pricing</p>
                            <div class="row g-3">
                                <div class="col-6 col-md-3">
                                    <label asp-for="@Model.Product.ListPrice" class="form-label fw-semibold small"></label>
                                    <input asp-for="@Model.Product.ListPrice" type="text" class="form-control" />
                                    <span asp-validation-for="@Model.Product.ListPrice" class="text-danger small"></span>
                                </div>
                                <div class="col-6 col-md-3">
                                    <label asp-for="@Model.Product.Price" class="form-label fw-semibold small"></label>
                                    <input asp-for="@Model.Product.Price" type="text" class="form-control" />
                                    <span asp-validation-for="@Model.Product.Price" class="text-danger small"></span>
                                </div>
                                <div class="col-6 col-md-3">
                                    <label asp-for="@Model.Product.Price50" class="form-label fw-semibold small"></label>
                                    <input asp-for="@Model.Product.Price50" type="text" class="form-control" />
                                    <span asp-validation-for="@Model.Product.Price50" class="text-danger small"></span>
                                </div>
                                <div class="col-6 col-md-3">
                                    <label asp-for="@Model.Product.Price100" class="form-label fw-semibold small"></label>
                                    <input asp-for="@Model.Product.Price100" type="text" class="form-control" />
                                    <span asp-validation-for="@Model.Product.Price100" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                        <div class="mt-3">
                            <label asp-for="@Model.Product.CategoryId" class="form-label fw-semibold small"></label>
                            <select asp-for="@Model.Product.CategoryId" asp-items="@Model.CategoryList" class="form-select">
                                <option disabled selected>--- Select category ---</option>
                            </select>
                            <span asp-validation-for="@Model.Product.CategoryId" class="text-danger small"></span>
                        </div>
                        <div class="mt-3">
                            <label class="form-label fw-semibold small">Product Image</label>
                            <div class="border border-2 border-dashed rounded p-4 text-center">
                                <i class="bi bi-cloud-upload fs-4 text-secondary"></i>
                                <input type="file" name="file" class="form-control form-control-sm mt-2" accept="image/*" />
                                <p class="text-secondary mt-1 mb-0" style="font-size: 0.75rem;" >Drag a single product image(JPG, PNG)</p>
                            </div>
                        </div>
                        <div class="d-flex gap-2 mt-2">
                            <button type="submit" class="btn btn-accent fw-semibold">@Model.Action</button>
                            <a asp-action="Index" class="btn btn-light fw-medium">Cancel</a>
                        </div>
                    </div>    
                    <div class="col-lg-4">
                        @if (!string.IsNullOrEmpty(Model.Product.ImageUrl))
                        {
                            <div class="border rounded p-3 bg-light text-center">
                                <p class="text-uppercase fw-semibold text-secondary mb-2" style="font-size: 0.75rem; letter-spacing: 0.15em;">Current Image</p>
                                <img src="~/@Model.Product.ImageUrl" class="img-fluid rounded shadow-sm mb-2" alt="@Model.Product.Title Image" />
                                <p class="text-secondary mb-0" style="font-size: 0.75rem;">Upload a new image to replace this one</p>
                            </div>
                        }
                        else
                        {
                            <div class="border rounded p-3 bg-light text-center">
                                <p class="text-uppercase fw-semibold text-secondary mb-2" style="font-size: 0.75rem; letter-spacing: 0.15em;">Current Image</p>
                                <i class="bi bi-image" style="font-size: 10rem; color:#94a3b8;"></i>
                                <p class="text-secondary mb-0" style="font-size: 0.75rem;">Upload a new image to replace this one</p>
                            </div>
                        }
                    </div>      
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}

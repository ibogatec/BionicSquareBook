@model RegisterViewModel

<div class="container">
    <div class="row justify-content-center mt-5 mb-5">
        <div class="col-md-8 col-lg-7">
            <div class="card shadow-sm border overflow-hidden">
                <div class="card-header text-white py-3 px-4 text-center" style="background: linear-gradient(to right, #065f46, #282828, #191414);">
                    <i class="bi bi-person-plus-fill display-4"></i>
                    <h4 class="fw-bold mt-2 mb-1">Create Account</h4>
                    <p class="mb-0 small" style="color: #1DB954;">Join us today</p>
                </div>

                <div class="card-body p-5">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="@Model.Name" class="form-label fw-semibold small"></label>
                                <input asp-for="@Model.Name" class="form-control form-control-lg" placeholder="Enter your name" />
                                <span asp-validation-for="@Model.Name" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="@Model.Email" class="form-label fw-semibold small"></label>
                                <input asp-for="@Model.Email" class="form-control form-control-lg" placeholder="name@example.com" />
                                <span asp-validation-for="@Model.Email" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="@Model.Password" class="form-label fw-semibold small"></label>
                                <input asp-for="@Model.Password" type="password" class="form-control form-control-lg" placeholder="Enter your password" />
                                <span asp-validation-for="@Model.Password" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="@Model.ConfirmPassword" class="form-label fw-semibold small"></label>
                                <input asp-for="@Model.ConfirmPassword" type="password" class="form-control form-control-lg" placeholder="**********" />
                                <span asp-validation-for="@Model.ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="@Model.PhoneNumber" class="form-label fw-semibold small"></label>
                            <input asp-for="@Model.PhoneNumber" class="form-control form-control-lg" placeholder="(+385) 51 234 7890" />
                            <span asp-validation-for="@Model.PhoneNumber" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="@Model.StreetAddress" class="form-label fw-semibold small"></label>
                            <input asp-for="@Model.StreetAddress" class="form-control form-control-lg" placeholder="123 Main St" />
                            <span asp-validation-for="@Model.StreetAddress" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-5 mb-3">
                                <label asp-for="@Model.City" class="form-label fw-semibold small"></label>
                                <input asp-for="@Model.City" class="form-control form-control-lg" placeholder="New York" />
                                <span asp-validation-for="@Model.City" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="@Model.State" class="form-label fw-semibold small"></label>
                                <input asp-for="@Model.State" class="form-control form-control-lg" placeholder="NY" />
                                <span asp-validation-for="@Model.State" class="text-danger small"></span>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label asp-for="@Model.PostalCode" class="form-label fw-semibold small"></label>
                                <input asp-for="@Model.PostalCode" class="form-control form-control-lg" placeholder="10001" />
                                <span asp-validation-for="@Model.PostalCode" class="text-danger small"></span>
                            </div>
                            <div class="col-md-12 mb-3">
                                <label asp-for="@Model.Role" class="form-label fw-semibold small"></label>
                                <select asp-for="@Model.Role" asp-items="@Model.RoleList" class="form-select form-control-lg"></select>
                                <span asp-validation-for="@Model.Role" class="text-danger small"></span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-accent btn-lg w-100 mb-3">
                            <i class="bi bi-person-check me-2"></i>Register
                        </button>
                    </form>

                    <hr class="my-4" />

                    <div class="text-center">
                        <p class="mb-0">
                            Already have an account? <a asp-action="Login" class="fw-semibold text-decoration-none" style="color: #17A34A;">Log in</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
